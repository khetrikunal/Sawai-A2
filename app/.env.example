# Environment Variables for Sawai Gir Amrut
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to version control.

# ── SUPABASE ──────────────────────────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard → Project Settings → API

# Public URL (safe in frontend)
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co

# Anon/public key (safe in frontend — RLS enforced)
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Same URL also needed server-side
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co

# Anon key (server-side copy)
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Service-role key — NEVER put this in VITE_ variables or commit it!
# Used only in server functions (supabase.server.ts) to bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# ── RAZORPAY ──────────────────────────────────────────────────────────────────
# Get these from: https://dashboard.razorpay.com → Settings → API Keys

# Public key ID (safe to expose — used in Razorpay Checkout on the frontend)
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXXXXXX

# Secret key — server-side ONLY, never expose in frontend code
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET

# Webhook secret — from Razorpay Dashboard → Webhooks → Add New Webhook
RAZORPAY_WEBHOOK_SECRET=YOUR_RAZORPAY_WEBHOOK_SECRET

# For production, replace rzp_test_ prefix with rzp_live_ prefix.

# ── EMAIL / SMTP ──────────────────────────────────────────────────────────────
# Supports any SMTP provider: Gmail, Mailgun, Resend (SMTP relay), Postmark, etc.
# For Gmail: use an App Password (not your account password) and enable 2FA.
# For Resend SMTP: host=smtp.resend.com, port=465, user=resend, pass=re_XXXX

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password-here
SMTP_FROM_NAME=Sawai Gir Amrut
SMTP_FROM_EMAIL=orders@sawaighee.com

# Admin notification email (receives new order alerts)
ADMIN_NOTIFICATION_EMAIL=admin@sawaighee.com

# ── ADMIN AUTHENTICATION ──────────────────────────────────────────────────────
# Generate a random secret for signing admin session tokens.
# Run: bun -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
ADMIN_SESSION_SECRET=GENERATE_A_RANDOM_64_BYTE_HEX_STRING

# Salt used when hashing the admin password before storing in DB.
# Run: bun -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_PASSWORD_SALT=GENERATE_A_RANDOM_32_BYTE_HEX_STRING

# To create the first admin user, run the setup script (see DEPLOYMENT.md):
# bun scripts/create-admin.mjs --email admin@sawaighee.com --password YOUR_PASSWORD

# ── NODE / APP ────────────────────────────────────────────────────────────────
NODE_ENV=development
